# Confirm the target is development or production before setting this value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Local JWT session secret for sparta-engineering.
SESSION_SECRET="change-this-local-session-secret"

# Dormant SSO configuration. Keep for the pending login-sparta integration.
SPARTA_API_URL="http://localhost:10000"
APP_BASE_URL="http://localhost:3000"
LOGIN_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/LOGIN_DATABASE?schema=public"

# Google Drive storage. Set these only on the server/runtime environment.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
DRIVE_CDN_CLIENT_ID=""
DRIVE_CDN_CLIENT_SECRET=""
DRIVE_CDN_REFRESH_TOKEN=""
DRIVE_CDN_SHARE_MODE="private"
DRIVE_CDN_SHARE_DOMAIN=""
