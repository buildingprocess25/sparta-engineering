generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  NIK                 String               @id
  name                String
  email               String?              @unique
  branchName          String
  location            String?
  role                UserRole             @default(ES)
  passwordHash        String
  mustChangePassword  Boolean              @default(true)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  reports             ChecklistReport[]    @relation("ReportAuthor")
  assignments         PicAssignment[]
  appliedWorkPermits  WorkPermit[]         @relation("WorkPermitApplicant")
  approvedWorkPermits WorkPermit[]         @relation("WorkPermitManager")
  workPermitApprovals WorkPermitApprover[]
}

model Area {
  id         String            @id @default(cuid())
  name       String
  type       AreaType
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  code       String            @unique
  isActive   Boolean           @default(true)
  rooms      Room[]
  reports    ChecklistReport[]
  equipments Equipment[]

  @@index([type])
  @@index([isActive])
}

model Room {
  id                 String                 @id @default(cuid())
  areaId             String
  name               String
  code               String                 @unique
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  area               Area                   @relation(fields: [areaId], references: [id])
  formAvailabilities RoomFormAvailability[]
  reports            ChecklistReport[]
  equipments         Equipment[]
  assignments        PicAssignment[]

  @@index([areaId])
  @@index([isActive])
}

model RoomFormAvailability {
  id        String          @id @default(cuid())
  roomId    String
  formCode  String
  period    ChecklistPeriod
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  room      Room            @relation(fields: [roomId], references: [id])

  @@unique([roomId, formCode, period])
  @@index([roomId])
  @@index([period])
}

model ChecklistReport {
  id                String                    @id @default(cuid())
  areaId            String
  roomId            String?
  authorId          String
  status            ReportStatus              @default(DRAFT)
  isSafe            Boolean                   @default(false)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)
  category          ReportCategory            @default(PREVENTIVE)
  period            ChecklistPeriod?
  periodKey         String?
  checklistPayload  Json                      @default("{}")
  approvalHistory   Json                      @default("[]")
  executionHistory  Json                      @default("[]")
  drivePhotoFileIds Json                      @default("[]")
  finalPdfDriveUrl  String?
  finalPdfFolderUrl String?
  formCode          String?
  reportCode        String?                   @unique
  items             ChecklistItem[]
  area              Area                      @relation(fields: [areaId], references: [id])
  room              Room?                     @relation(fields: [roomId], references: [id])
  author            User                      @relation("ReportAuthor", fields: [authorId], references: [NIK])
  taskId            String?                   @unique
  task              ChecklistTask?            @relation(fields: [taskId], references: [id])
  equipmentId       String?
  equipment         Equipment?                @relation(fields: [equipmentId], references: [id])
  workPermitId      String?
  workPermit        WorkPermit?               @relation(fields: [workPermitId], references: [id])
  revisions         ChecklistReportRevision[]

  @@unique([areaId, roomId, period, periodKey, formCode])
  @@index([authorId])
  @@index([areaId])
  @@index([roomId])
  @@index([equipmentId])
  @@index([workPermitId])
  @@index([status])
  @@index([reportCode])
}

model ChecklistReportRevision {
  id                 String          @id @default(cuid())
  reportId           String
  report             ChecklistReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reason             String?
  reviewerId         String?
  reviewerName       String?
  reviewStage        ReportStatus?
  requestedAt        DateTime?       @db.Timestamptz(3)
  resubmittedAt      DateTime?       @db.Timestamptz(3)
  previousPayload    Json
  resubmittedPayload Json?

  @@index([reportId, requestedAt])
}

model GoogleDriveFolderCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  folderId  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model ChecklistItem {
  id        String          @id @default(cuid())
  reportId  String
  itemName  String
  condition ItemCondition
  notes     String?
  photoUrls Json            @default("[]")
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  handler   String?
  report    ChecklistReport @relation(fields: [reportId], references: [id])

  @@index([reportId])
}

enum UserRole {
  ES
  COORD
  MANAGER
  REQUESTER
  ADMIN_HO
  SUPER_ADMIN
}

enum AreaType {
  OFFICE
  WAREHOUSE
}

enum ChecklistPeriod {
  MONTHLY
  WEEKLY
  QUARTERLY
  SEMESTER
}

enum ReportStatus {
  PENDING_COORD
  PENDING_MANAGER
  PENDING_REQUESTER
  COMPLETED
  REJECTED
  DRAFT
  NEEDS_REVISION
  WAITING_PB
  WAITING_PARTS
  IN_PROGRESS
}

enum ItemCondition {
  BAIK
  CLEAN
  REPAIR
  RUSAK
  TIDAK_ADA
  ADJUST_OR_ADD
  URGENT
}

enum ReportCategory {
  PREVENTIVE
  INCIDENTAL
}

enum TaskStatus {
  PENDING
  OVERDUE
  COMPLETED
  CANCELLED
}

model Equipment {
  id          String            @id @default(cuid())
  branchName  String
  roomId      String?
  areaId      String?
  name        String
  unitNo      Int               @default(1)
  code        String            @unique
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  room        Room?             @relation(fields: [roomId], references: [id])
  area        Area?             @relation(fields: [areaId], references: [id])
  assignments PicAssignment[]
  reports     ChecklistReport[]

  @@unique([branchName, name, unitNo])
  @@index([branchName])
  @@index([roomId])
  @@index([areaId])
}

model PicAssignment {
  id          String          @id @default(cuid())
  userNik     String
  equipmentId String?
  roomId      String?
  formCode    String
  period      ChecklistPeriod
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  user        User            @relation(fields: [userNik], references: [NIK])
  equipment   Equipment?      @relation(fields: [equipmentId], references: [id])
  room        Room?           @relation(fields: [roomId], references: [id])
  tasks       ChecklistTask[]

  @@index([userNik])
  @@index([equipmentId])
  @@index([roomId])
  @@index([period])
}

model ChecklistTask {
  id           String           @id @default(cuid())
  assignmentId String
  targetDate   DateTime         @db.Timestamptz(3)
  periodKey    String
  status       TaskStatus       @default(PENDING)
  completedAt  DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  assignment   PicAssignment    @relation(fields: [assignmentId], references: [id])
  report       ChecklistReport?

  @@unique([assignmentId, periodKey])
  @@index([assignmentId])
  @@index([status])
  @@index([periodKey])
}

model WorkPermit {
  id                String            @id @default(cuid())
  permitCode        String            @unique
  formCode          String            @default("SAT/FRM/MED/003_Rev:000_180225")
  kegiatan          String
  lokasi            String
  picSat            String
  kontraktor        String?
  workDate          DateTime          @db.Date
  duration          String
  workers           Json              @default("[]")
  safetyPayload     Json              @default("{}")
  catatanPasca      String?
  status            WorkPermitStatus  @default(PENDING_MANAGER)
  applicantNik      String
  applicantName     String?
  applicant         User              @relation("WorkPermitApplicant", fields: [applicantNik], references: [NIK])
  applicantSignedAt DateTime          @default(now()) @db.Timestamptz(3)
  managerNik        String?
  manager           User?             @relation("WorkPermitManager", fields: [managerNik], references: [NIK])
  managerSignedAt   DateTime?         @db.Timestamptz(3)
  managerNotes      String?
  approvalHistory   Json              @default("[]")
  reports           ChecklistReport[]
  approvalTokens    WorkPermitApprovalToken[]
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  @@index([applicantNik])
  @@index([managerNik])
  @@index([workDate])
  @@index([status])
}

model WorkPermitApprover {
  id           String                 @id @default(cuid())
  branchName   String
  userNik      String
  user         User                   @relation(fields: [userNik], references: [NIK])
  name         String?
  email        String?
  approvalRole WorkPermitApprovalRole
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(3)

  @@unique([branchName, userNik, approvalRole])
  @@index([branchName])
  @@index([userNik])
}

model WorkPermitApprovalToken {
  id            String                 @id @default(cuid())
  token         String                 @unique
  permitId      String
  permit        WorkPermit             @relation(fields: [permitId], references: [id], onDelete: Cascade)
  approverNik   String
  approverName  String
  approverEmail String
  approvalRole  WorkPermitApprovalRole
  targetStage   WorkPermitStatus
  expiresAt     DateTime               @db.Timestamptz(3)
  usedAt        DateTime?              @db.Timestamptz(3)
  decision      String?
  notes         String?
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)

  @@index([token])
  @@index([permitId])
  @@index([targetStage])
}

model DemoOutboxEmail {
  id          String    @id @default(cuid())
  toEmail     String
  toName      String?
  subject     String
  bodyHtml    String    @db.Text
  bodyText    String?   @db.Text
  actionUrl   String?
  metadata    Json?
  sentAt      DateTime  @default(now()) @db.Timestamptz(3)
  readAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([toEmail])
  @@index([sentAt])
}

enum WorkPermitStatus {
  PENDING_MANAGER
  PENDING_P2K3
  PENDING_SECRETARY
  APPROVED
  REJECTED
  COMPLETED
}

enum WorkPermitApprovalRole {
  P2K3
  DELEGATE
  SECRETARY
}
